+class EnvironmentIdentityTests(unittest.TestCase):
+    def test_codex_identity_survives_focus_and_expiry_then_detaches(self):
+        bridge = RecordingBridge()
+        self.assertTrue(bridge.report("running", claim=True))
+        self.assertEqual(bridge.session_agent_kinds["pane"], "codex")
+        bridge.expire_stale_agent_heartbeats(bridge.agent_heartbeat_times["pane"] + 9)
+        self.assertNotIn("pane", bridge.session_statuses)
+        self.assertEqual(bridge.session_agent_kinds["pane"], "codex")
+        self.assertTrue(bridge.report("finished", 2, event="finished"))
+        bridge.clear_finished_status("pane")
+        self.assertEqual(bridge.session_agent_kinds["pane"], "codex")
+        self.assertTrue(bridge.report("detached", 3, event="detached"))
+        self.assertNotIn("pane", bridge.session_agent_kinds)
+
+    def test_pi_recovery_identity_and_stale_report(self):
+        bridge = RecordingBridge()
+        request = dict(type="setSessionStatus", sessionId="pane", status="idle",
+                       reporterId="pi-reporter", sequence=2, agentKind="pi", recovery=True)
+        asyncio.run(bridge.handle_command(None, json.dumps(request).encode()))
+        self.assertTrue(bridge.responses[-1][0])
+        self.assertEqual(bridge.session_agent_kinds["pane"], "pi")
+        request.update(sequence=1, agentKind="codex", recovery=False)
+        asyncio.run(bridge.handle_command(None, json.dumps(request).encode()))
+        self.assertFalse(bridge.responses[-1][0])
+        self.assertEqual(bridge.session_agent_kinds["pane"], "pi")
+
+    def test_legacy_agent_is_not_inferred_as_pi(self):
+        bridge = RecordingBridge()
+        request = dict(type="setSessionStatus", sessionId="pane", status="idle")
+        asyncio.run(bridge.handle_command(None, json.dumps(request).encode()))
+        self.assertEqual(bridge.session_agent_kinds["pane"], "unknown")
+
+    def test_invalid_or_conflicting_identity_is_rejected(self):
+        for kind in ("shell", "other", [], {}):
+            bridge = RecordingBridge()
+            self.assertFalse(bridge.report("idle", claim=True, agentKind=kind))
+            self.assertEqual(bridge.session_agent_kinds, {})
+        bridge = RecordingBridge()
+        self.assertFalse(bridge.report("idle", claim=True, agentKind="pi"))
+        self.assertEqual(bridge.session_agent_kinds, {})
+
