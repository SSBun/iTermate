@@ -0,0 +1,114 @@
+"""Isolated integration check. Set AGENT_HOOKS_CLI to the framework dispatcher."""
+import asyncio
+import importlib.util
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import threading
+from types import SimpleNamespace
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+CLI = os.environ.get("AGENT_HOOKS_CLI")
+SPEC = importlib.util.spec_from_file_location("bridge", ROOT / "iTermateBridge/iTermateBridge.py")
+bridge_module = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(bridge_module)
+SESSION = "11111111-1111-1111-1111-111111111111"
+
+
+class LocalBridge(bridge_module.Bridge):
+    def __init__(self):
+        super().__init__(None, SimpleNamespace(get_session_by_id=lambda value: object() if value == SESSION else None))
+        self.response = None
+
+    async def send_action_result(self, writer, request_id, ok, error):
+        self.response = dict(type="actionResult", requestId=request_id, ok=ok, error=error)
+
+    async def publish_snapshot(self, target=None):
+        pass
+
+
+@unittest.skipUnless(CLI, "AGENT_HOOKS_CLI is required for the optional cross-repository integration")
+class AgentHooksIntegrationTests(unittest.TestCase):
+    def test_native_dispatcher_reporter_and_bridge_lifecycle(self):
+        with tempfile.TemporaryDirectory(prefix="itc-", dir="/tmp") as home:
+            support = Path(home) / "Library/Application Support/iTermate"
+            directory = support / "integrations"
+            directory.mkdir(parents=True)
+            (directory / "codex-agent-hooks.json").write_text(json.dumps({
+                "schema": "itermate.codex-agent-hooks/v1", "enabled": True,
+            }))
+            reporter = directory / "iTermate-status.py"
+            # Keep transport/state code real; the test is not a live Codex producer.
+            reporter.write_text("#!/usr/bin/env python3\nimport importlib.util\n"
+                                f"s=importlib.util.spec_from_file_location('reporter',{str(ROOT / 'integrations/status/iTermate-status.py')!r})\n"
+                                "m=importlib.util.module_from_spec(s);s.loader.exec_module(m)\n"
+                                "m.codex_hook_owner=lambda:None\nm.main()\n")
+            reporter.chmod(0o700)
+            data = Path(home) / "kit"
+            (data / "hooks").mkdir(parents=True)
+            (data / "hooks/config.json").write_text(json.dumps({
+                "schema": "agent-hooks.config/v1",
+                "disabledHooks": ["inner:agent-rules", "inner:csl-agent-kit-contract", "inner:refresh-tab-title"],
+            }))
+            bridge = LocalBridge()
+            errors = []
+            stopped = threading.Event()
+            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as listener:
+                listener.bind(str(support / "bridge.sock"))
+                listener.listen()
+                listener.settimeout(0.1)
+
+                def serve():
+                    while not stopped.is_set():
+                        try:
+                            client, _ = listener.accept()
+                        except socket.timeout:
+                            continue
+                        try:
+                            with client, client.makefile("rb") as stream:
+                                client.settimeout(2)
+                                request = stream.readline()
+                                asyncio.run(bridge.handle_command(None, request))
+                                frames = [{"type": "hello"}, {"type": "snapshot"}, bridge.response]
+                                client.sendall(b"".join((json.dumps(frame) + "\n").encode() for frame in frames))
+                        except Exception as error:
+                            errors.append(error)
+
+                worker = threading.Thread(target=serve)
+                worker.start()
+                env = {**os.environ, "HOME": home, "CSL_AGENT_KIT_HOME": str(data),
+                       "PLUGIN_ROOT": str(Path(CLI).resolve().parents[4]), "TERM_PROGRAM": "iTerm.app",
+                       "ITERM_SESSION_ID": "w0t0p0:" + SESSION}
+                try:
+                    steps = [
+                        ("SessionStart", "idle", {"source": "startup"}),
+                        ("UserPromptSubmit", "running", {"turn_id": "turn-1"}),
+                        ("SessionStart", "running", {"source": "compact"}),
+                        ("Interrupt", "idle", {"turn_id": "turn-1"}),
+                        ("UserPromptSubmit", "running", {"turn_id": "turn-2"}),
+                        ("Stop", "finished", {"turn_id": "turn-2"}),
+                        ("SessionEnd", None, {}),
+                    ]
+                    for event, expected, extra in steps:
+                        result = subprocess.run(["node", CLI, "dispatch"], input=json.dumps({
+                            "hook_event_name": event, "session_id": "codex-test", "cwd": home, **extra,
+                        }), text=True, capture_output=True, env=env, timeout=8)
+                        self.assertEqual(result.returncode, 0, result.stderr)
+                        self.assertNotIn("runtime-error", result.stderr)
+                        observed = bridge.session_statuses.get(SESSION, {})
+                        self.assertEqual(observed.get("status"), expected, event)
+                        if expected is not None:
+                            self.assertEqual(observed["activityKind"], "agent")
+                    self.assertEqual(errors, [])
+                finally:
+                    stopped.set()
+                    worker.join(timeout=3)
+                    self.assertFalse(worker.is_alive())
+
+
+if __name__ == "__main__":
+    unittest.main()
