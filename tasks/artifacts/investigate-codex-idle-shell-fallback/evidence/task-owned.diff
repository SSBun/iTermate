+    def test_internal_thread_start_cannot_replace_main_lifecycle(self):
+        for source in ("thread_title", "subagent", "guardian_review", "memory_consolidation"):
+            with self.subTest(source=source):
+                monitor = wrapper.StatusMonitor()
+                select(monitor)
+                notify(monitor, "turn/started", turn={"id": "main-turn"})
+                generation = monitor.generation
+                snapshots = list(monitor.snapshots)
+                monitor.observe({
+                    "id": 20, "method": "thread/start",
+                    "params": {"ephemeral": True, "threadSource": source},
+                }, False)
+                self.assertNotIn(20, monitor.requests)
+                monitor.observe({"id": 20, "result": {"thread": {
+                    "id": "temporary", "status": {"type": "idle"},
+                }}}, True)
+                notify(monitor, "turn/started", thread="temporary", turn={"id": "temp-turn"})
+                notify(monitor, "turn/completed", turn={"id": "main-turn", "status": "completed"})
+                self.assertEqual((monitor.thread_id, monitor.status), ("thread-1", "finished"))
+                notify(monitor, "turn/completed", thread="temporary", turn={"id": "temp-turn", "status": "completed"})
+                notify(monitor, "thread/closed", thread="temporary")
+                self.assertEqual((monitor.thread_id, monitor.status), ("thread-1", "finished"))
+                self.assertEqual(list(monitor.snapshots)[:-1], snapshots)
+                self.assertGreater(monitor.generation, generation)
+                notify(monitor, "turn/started", turn={"id": "next-turn"})
+                self.assertEqual(monitor.status, "running")
+                notify(monitor, "thread/closed")
+                self.assertEqual(monitor.status, "detached")
