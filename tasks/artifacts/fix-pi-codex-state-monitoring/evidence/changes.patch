+    func testMissingOrInvalidTimeDoesNotInventCompletionEvidence() {
+        for timestamp in [nil, 0, -1, .infinity, .nan] as [TimeInterval?] {
+            let result = observation(type: "idle", turns: [turn(status: "completed", completedAt: timestamp)])
