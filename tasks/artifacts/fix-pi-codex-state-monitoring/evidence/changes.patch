+        r"(?: [⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏])?",
+        title,
+        re.IGNORECASE | re.ASCII,
+    )
+    return match.group(1).rstrip(".").lower() if match else ""
 
 
