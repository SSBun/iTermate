+                || (includeUnloadedHistory && thread.status.type == "notLoaded") else {
+            return RuntimeObservation(
+                status: nil, changedAt: nil, latestCompletion: nil, recentCompletions: [],
+                rolloutPath: rolloutPath, sessionID: threadID
