+                changedAt = nil
+            }
+        } else {
+            switch latest?.status {
+            case "completed", "failed": status = .finished
+            case "interrupted": status = .interrupted
+            case nil: status = .idle
+            default: status = nil
+            }
+            changedAt = status == .finished || status == .interrupted
+                ? validTimestamp(latest?.completedAt) : nil
+        }
