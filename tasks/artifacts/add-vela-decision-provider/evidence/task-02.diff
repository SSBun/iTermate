+- Pi 交互集成仅在Agent settled后使用最后一条成功结束的助手文本。启用模型分析时调用 `/v1/question`，不再将旧的隐含待回复规则与模型结果做OR合并；关闭分析时保留既有规则行为。新一轮输入、切换分支、子代理活动和明确UI提问事件仍优先。
+- 问句决策取合法二分类的最大概率选项，不套用旧终端状态0.85门槛。校验两类概率、选择一致性和provider/instance，响应后再次比对配置revision、许可与端点。配置改变或过期响应被丢弃，不切换到其他模型。
+- 请求超时800ms、不可用、忙、非法结果或完整消息超过3000字符时，不截断后猜测、不换模型，也不把错误当作normal分类；本轮仅保留明确生命周期状态（已结束而非模型判定无问句）。已确认的等待仍由心跳保持直到下一轮或导航，切换模型只作用于后续判定。安装旧版本集成的Pi需通过应用安装入口更新并重新加载，不能只替换源码。
 - iTerm2 对没有真实状态的 Session 轮流读取可见终端文本末尾（最多 1500 字符），每个周期最多分析一个，结果最长保存 8 秒。界面以带问号的模型辅助标签显示，不写回权威状态，不计入完成次数或完成通知。不是按 Session 名称推测，也不能保证可见屏幕等于最后一条助手消息。
 - Ghostty 无法通过当前 AppleScript 接口读取正文；Pi 集成可以提供消息，其余没有集成的 Session 保持未知。
-- 模型常驻占用内存并竞争 GPU；单例结果不能证明所有语言和终端 UI 都能准确判断。关闭模型分析可立即恢复原有判定路径。
+- Laya常驻占用内存/GPU，Vela占用内存/CPU；同一App只保持所选worker。模型样例不能证明所有语言和终端UI都能准确判断；未执行真实用户会话的切换验收时不得把编译通过当作视觉验收。
 
 ## 验证限制
 
--- before/iTermateTests/LocalModelExitBarrierTests.swift
+++ current/iTermateTests/LocalModelExitBarrierTests.swift
@@ -0,0 +1,75 @@
+import Darwin
+import Foundation
+import XCTest
+@testable import iTermate
+
+final class LocalModelExitBarrierTests: XCTestCase {
+    /// Creates only a test-owned worker, with SIGTERM ignored before announcing readiness.
+    private func makeSlowExitingWorker() throws -> Process {
+        let child = Process()
+        let pipe = Pipe()
+        child.executableURL = URL(fileURLWithPath: "/bin/sh")
+        child.arguments = ["-c", "trap '' TERM; printf ready; exec /bin/sleep 30"]
+        child.standardOutput = pipe
+        try child.run()
+        XCTAssertEqual(pipe.fileHandleForReading.readData(ofLength: 5), Data("ready".utf8))
+        return child
+    }
+
+    private func finish(_ child: Process) {
+        if child.isRunning { kill(child.processIdentifier, SIGKILL) }
+        child.waitUntilExit()
+    }
+
+    @MainActor
+    func testStopThenSwitchAndStartWaitsForTheTerminatingWorker() async throws {
+        let child = try makeSlowExitingWorker()
+        defer { finish(child) }
+        let barrier = LocalModelExitBarrier()
+        barrier.stop(child)
+        // A second stop after clearing the service's current-process slot must retain the first worker.
+        barrier.stop(nil)
+        var passed = false
+        let nextStart = Task { @MainActor in
+            try await barrier.waitForExit { true }
+            passed = true
+        }
+        try await Task.sleep(nanoseconds: 100_000_000)
+        XCTAssertTrue(child.isRunning)
+        XCTAssertFalse(passed)
+        finish(child)
+        try await nextStart.value
+        XCTAssertTrue(passed)
+    }
+
+    @MainActor
+    func testCancelledSwitchDoesNotDiscardTheExitBarrierForTheNextStart() async throws {
+        let child = try makeSlowExitingWorker()
+        defer { finish(child) }
+        let barrier = LocalModelExitBarrier()
+        barrier.stop(child)
+        var current = true
+        let cancelledStart = Task { @MainActor in
+            try await barrier.waitForExit { current }
+        }
+        await Task.yield()
+        current = false
+        do {
+            try await cancelledStart.value
+            XCTFail("Obsolete start must not pass the barrier")
+        } catch is CancellationError {
+        }
+        XCTAssertTrue(child.isRunning)
+        barrier.stop(nil)
+        var passed = false
+        let nextStart = Task { @MainActor in
+            try await barrier.waitForExit { true }
+            passed = true
+        }
+        try await Task.sleep(nanoseconds: 100_000_000)
+        XCTAssertFalse(passed)
+        finish(child)
+        try await nextStart.value
+        XCTAssertTrue(passed)
+    }
+}
