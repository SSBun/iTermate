+        headers: encoded === undefined ? {} : {
+          "Content-Type": "application/json", "Content-Length": Buffer.byteLength(encoded),
+        },
+      }, response => {
+        if (response.statusCode !== 200) { finish(new SummaryGenerationError("provider")); return; }
